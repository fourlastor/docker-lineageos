#!/bin/bash

# Google Pixel C
# lineage-15.1 (Android 8.1) is the last branch with official support
# https://wiki.lineageos.org/devices/dragon/
LINEAGEOS_REPO=https://github.com/LineageOS/android.git
LINEAGEOS_BRANCH=lineage-15.1

DEVICE_CODENAME=dragon

# link to repo with the proprietary blobs
# https://wiki.lineageos.org/devices/dragon/build#extract-proprietary-blobs
PROPRIETARY_BLOBS_REPO=https://github.com/TheMuppets/proprietary_vendor_google
PROPRIETARY_BLOBS_DIR=$BASE_DIR/vendor/google

# Oreo's prebuilt flex crashes on newer glibc locales (Ubuntu 18.04+)
LC_ALL=C
